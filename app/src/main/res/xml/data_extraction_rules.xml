<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="traverse_cache.xml"/>
        <exclude domain="sharedpref" path="traverse_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="traverse_secure_ciphertext.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="traverse_cache.xml"/>
        <exclude domain="sharedpref" path="traverse_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="traverse_secure_ciphertext.xml"/>
    </device-transfer>
</data-extraction-rules>
